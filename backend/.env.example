# Supabase PostgreSQL Connection URL
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Project URL & Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gmail SMTP Live Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SendGrid Live Email Integration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_NAME=Interview Prep AI
SENDER_EMAIL=noreply@interviewprep.ai

# Security & CORS
CORS_ORIGINS=*
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI Model API Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
HF_API_TOKEN=your_huggingface_api_token

# Redis Cache
REDIS_URL=redis://localhost:6379

# Code Execution Service
PISTON_URL=http://localhost:2000/api/v2/execute

# Rate Limiting Configuration
RATE_LIMIT_AUTH_IP_MAX=5
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_PUBLIC_MAX=20
RATE_LIMIT_AUTHED_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
